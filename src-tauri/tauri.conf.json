{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yapper",
  "version": "0.1.0",
  "identifier": "net.ninjaruss.yapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yapper",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/Yapper/**",
          "$AUDIO/Yapper/**/*",
          "$AUDIO/Yapper/*",
          "$APPDATA/audio/**",
          "$APPDATA/audio/**/*",
          "$APPDATA/audio/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQjI4Nzg5QjUxOERDClJXVGNHTFdKaDdKYUFEWUFmVWI3R2hQZmlHUjhPVENQL3FsajhRZXlGdURqSVd2aGhveTNKSlZQCg==",
      "endpoints": [
        "https://github.com/Ninjaruss/yapper/releases/latest/download/latest.json"
      ]
    }
  }
}
